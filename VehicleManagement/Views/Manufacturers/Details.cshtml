@model VehicleManagement.ViewModels.ManufacturerDetailsViewModel
@using VehicleManagement.ViewModels

@{
    ViewData["Title"] = "Manufacturer Details";
    var initial = string.IsNullOrWhiteSpace(Model.Name) ? "?" : Model.Name.Trim()[0].ToString().ToUpper();
}
    <style>
    /* before */
    .col-weight { visibility: hidden; }

    /* after */
    .col-weight { display: none; }

    .table th:nth-child(3),
    .table td:nth-child(3) {
        display: none;
    }
    </style>

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="page-subtitle">View manufacturer information and its registered vehicles</p>
        </div>

        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </div>

    @* Manufacturer summary *@
    <div class="details-card">
        <div class="details-hero">
            <div class="details-avatar">@initial</div>
            <div>
                <h2 class="details-name">
                    @Model.Name
                    @if (Model.IsDefault)
                    {
                        <span class="badge badge-default">Default</span>
                    }
                </h2>
                <p class="details-meta">@(Model.IsDefault ? "Default manufacturer" : "Custom manufacturer")</p>
            </div>
        </div>

        <div class="details-stats">
            <div class="stat-tile">
                <span class="stat-label">Registered Vehicles</span>
                <span class="stat-value">@Model.VehicleCount</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">Type</span>
                <span class="stat-value stat-text">@(Model.IsDefault ? "Default" : "Custom")</span>
            </div>
        </div>
    </div>

    @* Vehicles *@
    <div class="section-header">
        <div>
            <h2>Vehicles <span class="count-pill">@Model.VehicleCount</span></h2>
            <p class="page-subtitle">Vehicles registered under this manufacturer</p>
        </div>
    </div>

    @if (!Model.Vehicles.Any())
    {
        <div class="empty-state">
            <h3>No vehicles registered</h3>
            <p>This manufacturer does not currently have any vehicles.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="vehicle-table">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(m => m.Vehicles.First().OwnerName)</th>
                            <th>@Html.DisplayNameFor(m => m.Vehicles.First().YearOfManufacture)</th>
                            <th class="col-weight">@Html.DisplayNameFor(m => m.Vehicles.First().Weight)</th>
                            <th>Category</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var vehicle in Model.Vehicles)
                        {
                            <tr>
                                <td><strong>@vehicle.OwnerName</strong></td>
                                <td>@vehicle.YearOfManufacture</td>
                                <td class="col-weight">@vehicle.Weight.ToString("0.00") kg</td>
                                <td>
                                    <i class="bi @VehicleCategoryIcons.GetCssClass(vehicle.CategoryIcon) me-2" aria-hidden="true"></i>
                                    <span class="badge-category">@vehicle.CategoryName</span></td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@vehicle.Id" class="action-view">View</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
