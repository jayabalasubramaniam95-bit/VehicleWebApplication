@model VehicleManagement.ViewModels.ManufacturerFormViewModel

@{
    ViewData["Title"] = Model.IsEdit ? "Edit Manufacturer" : "Add Manufacturer";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="page-subtitle">
                @(Model.IsEdit ? "Update manufacturer information" : "Register a new vehicle manufacturer")
            </p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to Manufacturers</a>
    </div>

    <div class="form-card">
        <form id="manufacturerForm" asp-action="@(Model.IsEdit ? "Edit" : "Create")">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group">
                <label asp-for="Name"></label>
                <input asp-for="Name"  style=" width: 50%;"  class="form-control" autocomplete="off" autofocus
                       maxlength="@VehicleManagement.ViewModels.ManufacturerFormViewModel.NameMaxLength" />
                <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
            </div>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "Save Changes" : "Add Manufacturer")
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const $form = $('#manufacturerForm');

            $form.find('.form-control').on('blur', function () { this.value = $.trim(this.value); });

            $form.on('submit', function () {
                if ($form.valid()) $form.find(':submit').prop('disabled', true);
            });
        });
    </script>
}
