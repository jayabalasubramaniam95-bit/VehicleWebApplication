@model VehicleManagement.ViewModels.VehicleCategoryFormViewModel
@using VehicleManagement.ViewModels

@{
    ViewData["Title"] = Model.IsEdit ? "Edit Vehicle Category" : "Add Vehicle Category";
    var hasRangeError = ViewData.ModelState.TryGetValue(string.Empty, out var modelErrors) && modelErrors!.Errors.Count > 0;
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                @(Model.IsEdit ? "Update the category name, weight range and icon." : "Create a new weight category.")
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to Categories
        </a>
    </div>

    <!-- Range errors (gap / overlap / split) come from the service as model-level errors -->
    @if (hasRangeError)
    {
        <div class="alert alert-danger d-flex align-items-start" role="alert">
            <i class="bi bi-exclamation-triangle me-2 mt-1"></i>
            <div>@string.Join(" ", modelErrors!.Errors.Select(e => e.ErrorMessage))</div>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">Category Details</h5>
        </div>

        <div class="card-body p-4">

            <form id="categoryForm" asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">

                <input type="hidden" asp-for="Id" />

                <!-- Name -->
                <div class="mb-4">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name"  style=" width: 50%;"  class="form-control" placeholder="e.g. Light" autocomplete="off"
                           maxlength="@VehicleCategoryFormViewModel.NameMaxLength" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- Weight range -->
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="MinWeight" class="form-label fw-semibold"></label>
                        <input asp-for="MinWeight"   style=" width: 50%;" type="number" step="0.01" min="0" class="form-control"
                               placeholder="e.g. 0" />
                        <span asp-validation-for="MinWeight" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="MaxWeight" class="form-label fw-semibold"></label>
                        <input asp-for="MaxWeight"  style=" width: 50%;"  type="number" step="0.01" min="0.01" class="form-control"
                               placeholder="No upper limit" />
                        <div class="form-text">Leave empty for "and above" (highest category only). The maximum itself belongs to the next category.</div>
                        <span asp-validation-for="MaxWeight" class="text-danger"></span>
                        <span id="rangeError" class="text-danger"></span>
                    </div>
                </div>

                <!-- Icon -->
                <div class="mb-4">
                    <label class="form-label fw-semibold d-block">Icon</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var option in VehicleCategoryIcons.All)
                        {
                            <div>
                                <input type="radio"  style="width: 50%;"  class="btn-check" asp-for="Icon" id="icon-@option.Key" value="@option.Key" />
                                <label class="btn btn-outline-secondary px-4 py-3 text-center" for="icon-@option.Key">
                                    <i class="bi @option.CssClass fs-2 d-block"></i>
                                    <span class="small">@option.Label</span>
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Icon" class="text-danger"></span>
                </div>

                <!-- Information -->
                <div class="alert alert-info d-flex">
                    <i class="bi bi-info-circle me-2 mt-1"></i>
                    <div>
                        Ranges must have no gaps or overlaps. Changing a boundary moves the neighbouring
                        category's boundary with it, and every existing vehicle is re-categorised automatically.
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border">Cancel</a>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        @(Model.IsEdit ? "Save Changes" : "Add Category")
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {
            const $form = $('#categoryForm'),
                  $min = $('#MinWeight'),
                  $max = $('#MaxWeight'),
                  $rangeError = $('#rangeError');

            // Trim the name when leaving the field
            $('#Name').on('blur', function () { this.value = $.trim(this.value); });

            $min.add($max).on('input', () => $rangeError.text(''));

            // Convenience only: the server is the source of truth for range rules
            $form.on('submit', function (e) {
                if (!$form.valid()) return;

                const min = parseFloat($min.val()), max = parseFloat($max.val());

                if (!isNaN(min) && !isNaN(max) && max <= min) {
                    e.preventDefault();
                    $rangeError.text('Maximum weight must be greater than minimum weight.');
                    return;
                }

                $form.find(':submit').prop('disabled', true);   // prevent double submit
            });
        });
    </script>
}
