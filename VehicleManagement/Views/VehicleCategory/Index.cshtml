@model VehicleManagement.ViewModels.VehicleCategoryListViewModel
@using VehicleManagement.ViewModels

@{
    ViewData["Title"] = "Vehicle Categories";

    var alerts = new[]
    {
        (Key: "SuccessMessage", Type: "success", Icon: "check-circle"),
        (Key: "ErrorMessage",   Type: "danger",  Icon: "exclamation-circle")
    };
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Vehicle Categories</h2>
            <p class="text-muted mb-0">Manage vehicle weight categories</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Category
        </a>
    </div>

    <!-- Success / Error Messages -->
    @foreach (var (key, type, icon) in alerts)
    {
        if (TempData[key] is string message)
        {
            <div class="alert alert-@type alert-dismissible fade show" role="alert">
                <i class="bi bi-@icon me-2"></i>
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    }

    <!-- Categories Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            @* Sorted in the browser (jQuery). data-col = column index, data-type = text | number *@
                            <th class="px-4">Icon</th>
                            <th>
                                <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-dark sort-button"
                                        data-col="1" data-type="text">
                                    Name <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-dark sort-button"
                                        data-col="2" data-type="number">
                                    Weight Range <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                                </button>
                            </th>
                            <th>
                                <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none text-dark sort-button"
                                        data-col="3" data-type="number">
                                    Vehicles <i class="bi bi-arrow-down-up sort-icon ms-1"></i>
                                </button>
                            </th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="categoryTableBody">
                        @foreach (var category in Model.Categories)
                        {
                            <tr class="category-row">
                                <td class="px-4">
                                    <i class="bi @VehicleCategoryIcons.GetCssClass(category.Icon) fs-4"></i>
                                </td>
                                <td class="fw-semibold" data-sort-value="@category.Name">@category.Name</td>
                                <td data-sort-value="@category.MinWeightSortKey">@category.WeightRange</td>
                                <td data-sort-value="@category.VehicleCount">
                                    <span class="badge text-bg-light border">@category.VehicleCount</span>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="Edit" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (category.IsUsedByVehicles)
                                        {
                                            <span class="d-inline-block" title="Category is used by vehicles">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal"
                                                    data-delete-id="@category.Id"
                                                    data-delete-name="@category.Name">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Categories.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No vehicle categories found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Business Rule Information -->
    <div class="alert alert-info mt-4 d-flex align-items-start">
        <i class="bi bi-info-circle me-3 mt-1"></i>
        <div>
            <strong>Category weight rules</strong>
            <div class="mt-1">
                Each range includes its minimum and excludes its maximum, so 500 kg belongs to the category that
                starts at 500. Ranges must have no gaps or overlaps, and every valid vehicle weight maps to exactly one category.
            </div>
        </div>
    </div>

</div>

<!-- Delete confirmation popup: one shared modal, filled in when a Delete button is clicked -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form id="deleteForm" asp-action="Delete" method="post" class="modal-content delete-modal">
            <input type="hidden" name="id" id="deleteId" />

            <div class="delete-dialog-body">
                <div class="delete-dialog-icon" aria-hidden="true">
                    <i class="bi bi-trash3"></i>
                </div>
                <div>
                    <h3 id="deleteModalLabel" class="delete-dialog-title">Delete category?</h3>
                    <p class="delete-dialog-text">
                        Are you sure to delete the category <strong id="deleteName"></strong>?
                    </p>
                </div>
            </div>

            <div class="delete-dialog-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Delete
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // ----- Sort: pure jQuery, toggles asc/desc on the rows already in the table (no server call) -----
            const $body = $('#categoryTableBody');
            const $buttons = $('.sort-button');
            let sortCol = 2, sortDir = 'asc';   // matches the server's default order (weight range, lowest first)

            const cellValue = (row, col) => $(row).children('td').eq(col).attr('data-sort-value') || '';

            const comparers = {
                text:   (a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }),
                number: (a, b) => Number(a) - Number(b)
            };

            const arrows = { none: 'bi-arrow-down-up', asc: 'bi-arrow-up', desc: 'bi-arrow-down' };

            function paintHeaders($active) {
                $buttons.removeClass('text-primary').addClass('text-dark')
                        .find('.sort-icon').attr('class', 'bi ' + arrows.none + ' sort-icon ms-1');

                $active.removeClass('text-dark').addClass('text-primary')
                       .find('.sort-icon').attr('class', 'bi ' + arrows[sortDir] + ' sort-icon ms-1');
            }

            paintHeaders($buttons.filter('[data-col="' + sortCol + '"]'));

            $buttons.on('click', function () {
                const col = $(this).data('col');
                const compare = comparers[$(this).data('type')];

                // Same column: flip direction. New column: start ascending.
                sortDir = (col === sortCol && sortDir === 'asc') ? 'desc' : 'asc';
                sortCol = col;
                const sign = sortDir === 'asc' ? 1 : -1;

                // Re-appending the existing <tr> elements moves them; nothing is re-rendered or re-fetched
                $body.append($body.children('tr.category-row').get().sort((a, b) =>
                    sign * compare(cellValue(a, col), cellValue(b, col))));

                paintHeaders($(this));
            });

            // ----- Delete popup: fill the shared modal from the clicked button -----
            $('[data-delete-id]').on('click', function () {
                $('#deleteId').val($(this).data('delete-id'));
                $('#deleteName').text($(this).data('delete-name'));
            });

            // Prevent double submit
            $('#deleteForm').on('submit', function () {
                $(this).find(':submit').prop('disabled', true);
            });
        });
    </script>
}
