@model VehicleManagement.ViewModels.VehicleDetailsViewModel
@using VehicleManagement.ViewModels


@{
    ViewData["Title"] = "Vehicle Details";

    var categoryName = string.IsNullOrWhiteSpace(Model.CategoryName)
        ? "Unknown"
        : Model.CategoryName.Trim();

    // Known categories get their own style and image. Anything else falls back to the defaults.
    var (categoryClass, categoryImageName) = categoryName.ToLowerInvariant() switch
    {
        "light"  => ("category-light", "light"),
        "medium" => ("category-medium", "medium"),
        "heavy"  => ("category-heavy", "heavy"),
        _        => ("category-default", "medium")
    };

    var categoryImage = Url.Content($"~/images/vehicle-categories/{categoryImageName}.jpg");
}

<div class="vehicle-details-page">

    @* Page header *@
    <div class="page-header">
        <div class="page-header-content">
            <div class="page-icon">
                <i class="bi bi-truck" aria-hidden="true"></i>
            </div>
            <div>
                <h1>Vehicle Details</h1>
                <p class="page-subtitle">View complete information about this vehicle</p>
            </div>
        </div>

        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1" aria-hidden="true"></i>
                Edit Vehicle
            </a>
            <a asp-action="Index" class="btn btn-light">
                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
                Back to Vehicles
            </a>
        </div>
    </div>

    @* Main content *@
    <div class="vehicle-details-grid">

        @* Vehicle information card *@
        <div class="details-card">
            <div class="details-card-header">
                <div>
                    <h2>Vehicle Information</h2>
                    <p>Basic information about the vehicle</p>
                </div>
                <div class="vehicle-id">#@Model.Id</div>
            </div>

            <div class="details-card-body">

                @* Owner *@
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-person" aria-hidden="true"></i>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">@Html.DisplayNameFor(m => m.OwnerName)</span>
                        <span class="detail-value">@Html.DisplayFor(m => m.OwnerName)</span>
                    </div>
                </div>

                @* Manufacturer *@
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-building" aria-hidden="true"></i>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">@Html.DisplayNameFor(m => m.ManufacturerName)</span>
                        <span class="detail-value">@Html.DisplayFor(m => m.ManufacturerName)</span>
                    </div>
                </div>

                @* Year *@
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-calendar3" aria-hidden="true"></i>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">@Html.DisplayNameFor(m => m.YearOfManufacture)</span>
                        <span class="detail-value">@Html.DisplayFor(m => m.YearOfManufacture)</span>
                    </div>
                </div>

                @* Weight *@
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">@Html.DisplayNameFor(m => m.WeightKg)</span>
                        <span class="detail-value">@Model.WeightKg.ToString("N2") kg</span>
                    </div>
                </div>

                @* Category *@
                <div class="detail-item category-detail">
                    <div class="detail-icon">
                        <i class="bi bi-truck-front" aria-hidden="true"></i>
                    </div>
                    <div class="detail-content">
                        <span class="detail-label">@Html.DisplayNameFor(m => m.CategoryName)</span>

                        <div class="category-display">
                            <img src="@categoryImage"
                                 alt="@categoryName vehicle category"
                                 class="category-image" />

                            <div class="category-info">
                                <span class="category-name @categoryClass">@categoryName</span>
                                <span class="category-description">Vehicle classification</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        @* Category summary card *@
        <div class="category-card">
            <div class="category-card-header">
                <h2>Vehicle Category</h2>
            </div>

            <div class="category-card-content">
                <img src="@categoryImage"
                     alt="@categoryName vehicle category"
                     class="category-large-image"
                     loading="lazy" />

                <h3>@categoryName</h3>

                <p>
                    This vehicle is currently classified as
                    <strong>@categoryName</strong>
                    based on its recorded weight.
                </p>

                <div class="category-status @categoryClass">
                    <span class="status-dot" aria-hidden="true"></span>
                    <span>@categoryName Category</span>
                </div>
            </div>
        </div>

    </div>

    @* Bottom actions *@
    <div class="details-footer">
        <a asp-action="Index" class="btn btn-light">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to Vehicles
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1" aria-hidden="true"></i>
            Edit Vehicle
        </a>
    </div>

</div>

<style>
    /* Page */
    .vehicle-details-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    /* Header */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .page-header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .page-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eef4ff;
        color: #2563eb;
        font-size: 24px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }

    .page-subtitle {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
    }

    /* Main grid */
    .vehicle-details-grid {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
        gap: 24px;
        align-items: stretch;
    }

    /* Cards */
    .details-card,
    .category-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    .details-card-header,
    .category-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 22px 24px;
        border-bottom: 1px solid #e5e7eb;
    }

    .details-card-header h2,
    .category-card-header h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
    }

    .details-card-header p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 13px;
    }

    .vehicle-id {
        padding: 6px 10px;
        border-radius: 8px;
        background: #f3f4f6;
        color: #4b5563;
        font-size: 13px;
        font-weight: 600;
    }

    /* Detail rows */
    .details-card-body {
        padding: 8px 24px;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .detail-item:last-child {
        border-bottom: none;
    }

    .detail-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f8fafc;
        color: #64748b;
        font-size: 18px;
    }

    .detail-content {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .detail-label {
        color: #6b7280;
        font-size: 12px;
        font-weight: 500;
    }

    .detail-value {
        color: #111827;
        font-size: 15px;
        font-weight: 600;
    }

    /* Category (inside the details card) */
    .category-display {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 5px;
    }

    .category-image {
        width: 70px;
        height: 50px;
        object-fit: cover;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
    }

    .category-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .category-name {
        font-size: 15px;
        font-weight: 700;
    }

    .category-description {
        color: #6b7280;
        font-size: 12px;
    }

    /* Category summary card */
    .category-card {
        display: flex;
        flex-direction: column;
    }

    .category-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 30px 24px;
        text-align: center;
    }

    .category-large-image {
        width: 100%;
        max-width: 260px;
        height: 170px;
        margin-bottom: 22px;
        object-fit: cover;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
    }

    .category-card-content h3 {
        margin: 0 0 8px;
        font-size: 24px;
        font-weight: 700;
    }

    .category-card-content p {
        max-width: 300px;
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
    }

    .category-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
    }

    /* Category colors */
    .category-light   { color: #15803d; }
    .category-medium  { color: #b45309; }
    .category-heavy   { color: #b91c1c; }
    .category-default { color: #475569; }

    /* Footer */
    .details-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 24px;
    }

    /* Responsive */
    @@media (max-width: 900px) {
        .vehicle-details-grid {
            grid-template-columns: 1fr;
        }

        .category-card-content {
            padding: 24px;
        }
    }

    @@media (max-width: 650px) {
        .vehicle-details-page {
            padding: 20px 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .action-buttons {
            width: 100%;
        }

        .action-buttons .btn,
        .details-footer .btn {
            flex: 1;
        }

        .details-footer {
            justify-content: stretch;
        }
    }
</style>