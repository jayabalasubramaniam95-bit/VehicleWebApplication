@model VehicleManagement.ViewModels.VehicleFormViewModel

@{
    ViewData["Title"] = Model.IsEdit ? "Edit Vehicle" : "Add Vehicle";
}

<div class="page-container">

    <div class="page-header">
        <div>
            <h1>@ViewData["Title"]</h1>
            <p class="page-subtitle">
                @(Model.IsEdit ? "Update vehicle information" : "Register a new vehicle")
            </p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Back to Vehicles</a>
    </div>

    <div class="form-card">
        <form id="vehicleForm" asp-action="@(Model.IsEdit ? "Edit" : "Create")" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="validation-summary text-danger"></div>

            <div class="form-group">
                <label asp-for="OwnerName"  style=" width: 50%;" class="form-label"></label>
                <input asp-for="OwnerName"  style=" width: 50%;"class="form-control" placeholder="Enter owner name"
                       autocomplete="off" autofocus
                       maxlength="@VehicleManagement.ViewModels.VehicleFormViewModel.OwnerNameMaxLength" />
                <span asp-validation-for="OwnerName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ManufacturerId"  style=" width: 50%;" class="form-label"></label>
                <select asp-for="ManufacturerId" asp-items="Model.Manufacturers"  style=" width: 50%;" class="form-control">
                    <option value="">-- Select Manufacturer --</option>
                </select>
                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="YearOfManufacture"  style=" width: 50%;" class="form-label"></label>
                <input asp-for="YearOfManufacture" type="number"  style=" width: 50%;" class="form-control" placeholder="e.g. 2020" />
                <span asp-validation-for="YearOfManufacture" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Weight"  style=" width: 50%;"class="form-label"></label>
                <input asp-for="Weight" type="number" step="0.01" min="0.01"  style=" width: 50%;" class="form-control"
                       placeholder="e.g. 1850.75" />
                <span asp-validation-for="Weight" class="text-danger"></span>
                <small class="form-text text-muted" style="color:red">
                   * The category is assigned automatically from the weight when you save.
                </small>
            </div>
           <br/>

            <div class="form-actions">
                <a asp-action="Index" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    @(Model.IsEdit ? "Save Changes" : "Add Vehicle")
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(function () {
            const $form = $('#vehicleForm');

            // Trim the owner name when leaving the field
            $('#OwnerName').on('blur', function () { this.value = $.trim(this.value); });

            // Prevent double submit once the form is valid
            $form.on('submit', function () {
                if ($form.valid()) $form.find(':submit').prop('disabled', true);
            });
        });
    </script>
}
