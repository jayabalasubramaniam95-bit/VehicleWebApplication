@model VehicleManagement.ViewModels.VehicleListViewModel
@using VehicleManagement.ViewModels

@{
    ViewData["Title"] = "Vehicles";

    var alerts = new[]
    {
        ("SuccessMessage", "success"),
        ("ErrorMessage", "danger")
    };
}
<style>
/* before */
.col-weight { visibility: hidden; }

/* after */
.col-weight { display: none; }

.table th:nth-child(4),
.table td:nth-child(4) {
    display: none;
}
</style>

<div class="page-container">

    <!-- Header -->
    <div class="page-header">
        <h1>Vehicles</h1>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add Vehicle
        </a>
    </div>

    <!-- Alerts -->
    @foreach (var (key, css) in alerts)
    {
        if (TempData[key] is string message)
        {
            <div class="alert alert-@css">@message</div>
        }
    }

    <!-- Toolbar -->
    <div class="vehicle-toolbar">

        <div class="sort-group">
            <label for="sortColumn">Sort by:</label>

            <select id="sortColumn"  style="width: auto;" class="sort-select">
                <option value="0">Owner Name</option>
                <option value="1">Manufacturer</option>
                <option value="2">Year</option>
                <option value="3">Weight</option>
                <option value="4">Category</option>
            </select>

            <select id="sortDirection" style="width: auto;" class="sort-select direction-select">
                <option value="asc">Ascending</option>
                <option value="desc">Descending</option>
            </select>
        </div>

        <form asp-action="Index" method="get" id="searchForm" class="vehicle-search">
            <div class="search-input-wrapper">
                <i class="bi bi-search"></i>
                <input asp-for="Search"
                       class="search-input"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>
        </form>

    </div>

    @if (!Model.Vehicles.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">
                <i class="bi bi-car-front"></i>
            </div>

            <h3>No vehicles found</h3>

            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <p>There are no registered vehicles yet.</p>

                <a asp-action="Create" class="btn btn-primary">
                    Add Vehicle
                </a>
            }
            else
            {
                <p>
                    No vehicles match
                    "<strong>@Model.Search</strong>".
                </p>

                <a asp-action="Index" class="btn btn-light">
                    Clear Search
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">

                <table id="vehicleTable" class="vehicle-table">

                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Manufacturer</th>
                            <th>Year</th>
                            <th class="col-weight">Weight</th>
                            <th>Category</th>
                            <th class="actions-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="vehicleTableBody">

                        @foreach (var vehicle in Model.Vehicles)
                        {
                            <tr>

                                <td data-sort-value="@vehicle.OwnerName">
                                    @vehicle.OwnerName
                                </td>

                                <td data-sort-value="@vehicle.ManufacturerName">
                                    @vehicle.ManufacturerName
                                </td>

                                <td data-sort-value="@vehicle.YearOfManufacture">
                                    @vehicle.YearOfManufacture
                                </td>
                                <td  class="col-weight" data-sort-value="@vehicle.Weight">
                                    @vehicle.Weight kg
                                </td>

                                <td data-sort-value="@vehicle.CategoryName">
                                    <div class="vehicle-category">
                                        <i class="bi @VehicleCategoryIcons.GetCssClass(vehicle.CategoryIcon)"
                                           aria-hidden="true"></i>

                                        <span>@vehicle.CategoryName</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@vehicle.Id"
                                           class="action-view"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@vehicle.Id"
                                           class="action-edit"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@vehicle.Id"
                                           class="action-delete"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

        <!-- Pagination -->
        <div class="pagination-container">

            <div class="pagination-summary">
                Showing
                <strong>@Model.FirstItem</strong> -
                <strong>@Model.LastItem</strong> of
                <strong>@Model.TotalItems</strong>
                vehicles
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="pagination" aria-label="Vehicle pagination">

                    @if (Model.HasPrevious)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Model.Search"
                           class="pagination-link">
                            &lsaquo;
                        </a>
                    }
                    else
                    {
                        <span class="pagination-link disabled">&lsaquo;</span>
                    }

                    @for (var pages = 1; pages <= Model.TotalPages; pages++)
                    {
                        if (pages == Model.CurrentPage)
                        {
                            <span class="pagination-link active"
                                  aria-current="page">
                                @pages
                            </span>
                        }
                        else
                        {
                            <a asp-action="Index"
                               asp-route-page="@pages"
                               asp-route-search="@Model.Search"
                               class="pagination-link">
                                @pages
                            </a>
                        }
                    }

                    @if (Model.HasNext)
                    {
                        <a asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Model.Search"
                           class="pagination-link">
                            &rsaquo;
                        </a>
                    }
                    else
                    {
                        <span class="pagination-link disabled">&rsaquo;</span>
                    }

                </nav>
            }

        </div>
    }

</div>

<!-- Delete Dialog -->
<dialog id="deleteDialog"
        class="delete-dialog"
        aria-labelledby="deleteTitle">

    <form id="deleteForm"
          asp-action="Delete"
          method="post">

        <input type="hidden"
               id="deleteId"
               name="id" />

        <div class="delete-dialog-body">

            <div class="delete-dialog-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <div>
                <h3 id="deleteTitle" class="delete-dialog-title">
                    Delete vehicle?
                </h3>

                <p class="delete-dialog-text">
                    Are you sure you want to delete the vehicle owned by
                    <strong id="deleteName"></strong>?
                </p>
            </div>

        </div>

        <div class="delete-dialog-footer">

            <button type="button"
                    class="btn btn-light"
                    data-close-dialog>
                Cancel
            </button>

            <button type="submit"
                    class="btn btn-danger">
                <i class="bi bi-trash3 me-1"></i>
                Delete
            </button>

        </div>

    </form>

</dialog>

@section Scripts
{
    <script>
        $(function () {

            let timer;

            $('#Search').on('input', function () {
                clearTimeout(timer);
                timer = setTimeout(() => $('#searchForm').submit(), 400);
            });

            const $body = $('#vehicleTableBody');

            $('#sortColumn, #sortDirection').on('change', function () {

                const column = +$('#sortColumn').val();
                const direction = $('#sortDirection').val();

                const rows = $body.children('tr').get();

                rows.sort((a, b) => {

                    const valueA = $(a).children('td').eq(column).data('sort-value') ?? '';
                    const valueB = $(b).children('td').eq(column).data('sort-value') ?? '';

                    const result = [2, 3].includes(column)
                        ? Number(valueA) - Number(valueB)
                        : String(valueA).localeCompare(String(valueB), undefined, {
                            sensitivity: 'base'
                        });

                    return direction === 'asc'
                        ? result
                        : -result;
                });

                $body.append(rows);
            });

            const dialog = document.getElementById('deleteDialog');

            $('[data-delete-id]').on('click', function (e) {

                e.preventDefault();

                $('#deleteId').val($(this).data('delete-id'));
                $('#deleteName').text($(this).data('delete-name'));

                dialog.showModal();
            });

            $('[data-close-dialog]').on('click', () => dialog.close());

            $(dialog).on('click', e => {
                if (e.target === dialog)
                    dialog.close();
            });

            $('#deleteForm').on('submit', function () {
                $(this).find(':submit').prop('disabled', true);
            });

        });
    </script>
}